{#
  ROOT END-USER EMAIL TEMPLATE
  Edit this file to apply your branding and layout. Keep styles inline for email clients.

  Available values:
    report.report_date, report.items
    item.title, item.url, item.summary, item.category, item.source,
    item.severity.value, item.score, item.published_at
#}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <title>Cyber Daily News</title>
  </head>
  <body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,sans-serif;color:#172033">
    <div style="display:none;max-height:0;overflow:hidden;color:transparent">
      The most relevant cyber developments for {{ report.report_date }}.
    </div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f4f6">
      <tr>
        <td align="center" style="padding:24px 12px">
          <table role="presentation" width="680" cellspacing="0" cellpadding="0" border="0" style="max-width:680px;width:100%;background:#ffffff;border-collapse:collapse;border-radius:12px;overflow:hidden;box-shadow:0 4px 18px rgba(20,43,74,.10)">
            <tr>
              <td style="background:#142b4a;color:#ffffff;padding:28px 32px">
                <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#b9d8f3">Executive Briefing</div>
                <h1 style="margin:9px 0 0;font-size:30px;line-height:1.2">Cyber Daily News</h1>
                <div style="margin-top:10px;font-size:14px;color:#dce8f4">{{ report.report_date.strftime('%B %d, %Y') }} &nbsp;|&nbsp; {{ report.items|length }} prioritized {% if report.items|length == 1 %}story{% else %}stories{% endif %}</div>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 32px;background:#eaf0f7;border-bottom:1px solid #d7e1ec;font-size:14px;line-height:1.55;color:#334b65">
                A concise view of today&rsquo;s highest-priority public-source cyber reporting, selected for leadership awareness.
              </td>
            </tr>
            <tr>
              <td style="padding:8px 32px 24px">
              {% if report.items %}
                {% for item in report.items %}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-bottom:1px solid #d9dee7;border-collapse:collapse">
                  <tr>
                    <td style="padding:24px 0">
                      <div style="font-size:11px;color:#52647a;text-transform:uppercase;letter-spacing:.7px;font-weight:bold">
                        {{ loop.index }} &nbsp;&bull;&nbsp; {{ item.category }} &nbsp;&bull;&nbsp; {{ item.source }}
                      </div>
                      <h2 style="font-size:21px;line-height:1.32;margin:9px 0 10px">
                        <a href="{{ item.url }}" style="color:#075da8;text-decoration:underline">{{ item.title }}</a>
                      </h2>
                      <p style="font-size:15px;line-height:1.6;margin:0 0 15px;color:#26354a">{{ item.summary }}</p>
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f7fb;border-left:4px solid #2374ab;border-collapse:collapse">
                        <tr>
                          <td style="padding:12px 14px;font-size:13px;line-height:1.5;color:#334b65">
                            <strong style="display:block;margin-bottom:3px;color:#142b4a;text-transform:uppercase;font-size:11px;letter-spacing:.6px">Why this is relevant</strong>
                            {% if item.score >= 9 %}A top-priority development with potential for significant business or security impact. Leadership awareness and timely review are recommended.{% elif item.score >= 7 %}A high-priority development that may affect organizational risk, operations, or near-term security decisions.{% else %}One of today&rsquo;s strongest-ranked developments, included for situational awareness and potential organizational impact.{% endif %}
                          </td>
                        </tr>
                      </table>
                      <div style="margin-top:12px;font-size:11px;color:#63758a;text-transform:uppercase;letter-spacing:.5px">
                        Relevance score {{ '%.1f'|format(item.score) }}/10 &nbsp;&bull;&nbsp; {{ item.severity.value }} priority
                      </div>
                    </td>
                  </tr>
                </table>
                {% endfor %}
              {% else %}
                <p style="padding:20px 0;line-height:1.5">No qualifying cyber-intelligence items were identified for this report.</p>
              {% endif %}
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px;background:#142b4a;color:#dce5ef;font-size:12px;line-height:1.5">
                This automated briefing uses public sources. Validate intelligence before taking action.<br>
                Scores reflect your configured risk signals and company watchlist.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
