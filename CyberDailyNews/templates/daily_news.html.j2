<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Daily Cyber Intelligence</title>
  </head>
  <body style="margin:0;background:#f3f4f6;font-family:Arial,sans-serif;color:#172033">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr><td align="center" style="padding:24px">
        <table role="presentation" width="680" cellspacing="0" cellpadding="0" border="0" style="max-width:680px;width:100%;background:#ffffff">
          <tr><td style="background:#142b4a;color:#ffffff;padding:28px 32px">
            <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase">Cyber Intelligence</div>
            <h1 style="margin:8px 0 0;font-size:28px">Daily Cyber Intelligence</h1>
            <div style="margin-top:8px">{{ report.report_date.strftime('%B %d, %Y') }}</div>
          </td></tr>
          <tr><td style="padding:24px 32px">
          {% if report.items %}
            {% for item in report.items %}
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-bottom:1px solid #d9dee7">
              <tr><td style="padding:18px 0">
                <div style="font-size:12px;color:#52647a;text-transform:uppercase">{{ item.category }} · {{ item.source }} · {{ item.severity.value }}</div>
                <h2 style="font-size:20px;margin:7px 0"><a href="{{ item.url }}" style="color:#075da8">{{ item.title }}</a></h2>
                <p style="line-height:1.5;margin:0">{{ item.summary }}</p>
              </td></tr>
            </table>
            {% endfor %}
          {% else %}
            <p>No qualifying cyber-intelligence items were identified for this report.</p>
          {% endif %}
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
